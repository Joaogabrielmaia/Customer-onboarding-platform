// Modelo de dados da Trilha. Desenho e motivos em docs/03-arquitetura/modelo-de-dados.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  IMPLEMENTER
}

enum Plan {
  ESSENTIAL
  PROFESSIONAL
  NETWORK
}

enum AssigneeKind {
  IMPLEMENTER
  CLIENT
  ADMIN
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  WAITING_CLIENT
  DONE
  NOT_APPLICABLE
}

enum DeploymentStatus {
  IN_PROGRESS
  COMPLETED
}

enum AuditAction {
  DEPLOYMENT_CREATED
  DEPLOYMENT_COMPLETED
  DEPLOYMENT_REOPENED
  TASK_STATUS_CHANGED
  TASK_DUE_DATE_CHANGED
  TASK_ASSIGNEE_CHANGED
  COMMENT_ADDED
  PORTAL_LINK_CREATED
  PORTAL_LINK_REVOKED
  SETTINGS_CHANGED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  sessions    Session[]
  deployments Deployment[]
  tasks       DeploymentTask[]
  comments    Comment[]
  auditLogs   AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Configuração global. Sempre uma linha, com id = 1.
model Setting {
  id                   Int @id @default(1)
  overdueToleranceDays Int @default(0)
  portalLinkDays       Int @default(60)
}

model Client {
  id           String    @id @default(cuid())
  companyName  String
  cnpj         String?
  contactName  String
  contactEmail String
  contactPhone String?
  plan         Plan
  contractDate DateTime  @db.Date
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  deployments Deployment[]
}

model Template {
  id          String    @id @default(cuid())
  name        String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  stages      TemplateStage[]
  deployments Deployment[]
}

model TemplateStage {
  id         String @id @default(cuid())
  templateId String
  name       String
  position   Int

  template Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks    TemplateTask[]

  @@index([templateId])
}

model TemplateTask {
  id              String       @id @default(cuid())
  stageId         String
  title           String
  description     String?
  offsetDays      Int
  assigneeKind    AssigneeKind
  required        Boolean      @default(true)
  visibleToClient Boolean      @default(false)
  position        Int

  stage TemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
}

model Deployment {
  id            String           @id @default(cuid())
  clientId      String
  templateId    String?
  templateName  String
  implementerId String
  kickoffDate   DateTime         @db.Date
  status        DeploymentStatus @default(IN_PROGRESS)
  completedAt   DateTime?        @db.Date
  createdAt     DateTime         @default(now())

  client      Client            @relation(fields: [clientId], references: [id])
  template    Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  implementer User              @relation(fields: [implementerId], references: [id])
  stages      DeploymentStage[]
  tasks       DeploymentTask[]
  auditLogs   AuditLog[]
  portalLinks PortalLink[]

  @@index([status])
  @@index([clientId])
  @@index([implementerId])
}

model DeploymentStage {
  id           String @id @default(cuid())
  deploymentId String
  name         String
  position     Int

  deployment Deployment       @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  tasks      DeploymentTask[]

  @@index([deploymentId])
}

model DeploymentTask {
  id              String       @id @default(cuid())
  deploymentId    String
  stageId         String
  title           String
  description     String?
  dueDate         DateTime     @db.Date
  originalDueDate DateTime     @db.Date
  assigneeKind    AssigneeKind
  assigneeId      String?
  required        Boolean
  visibleToClient Boolean
  status          TaskStatus   @default(PENDING)
  completedAt     DateTime?    @db.Date
  position        Int

  deployment Deployment      @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  stage      DeploymentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  assignee   User?           @relation(fields: [assigneeId], references: [id])
  comments   Comment[]

  @@index([deploymentId])
  @@index([assigneeId, status])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   DeploymentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

// Somente inserção: a aplicação não edita nem apaga estes registros.
model AuditLog {
  id           String      @id @default(cuid())
  deploymentId String?
  taskId       String?
  actorId      String?
  action       AuditAction
  field        String?
  oldValue     String?
  newValue     String?
  reason       String?
  createdAt    DateTime    @default(now())

  deployment Deployment? @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  actor      User?       @relation(fields: [actorId], references: [id])

  @@index([deploymentId, createdAt])
}

model PortalLink {
  id           String    @id @default(cuid())
  deploymentId String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
}
