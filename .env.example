# Copie para .env e preencha. NUNCA versione o .env.
# Os valores abaixo são apenas ilustrativos, não são credenciais reais.

# Conexão do app com o PostgreSQL.
# Local (npm run setup sobe o banco no Docker): postgresql://trilha:trilha@localhost:5433/trilha?schema=public
# Na Render, a variável vem do banco criado pelo render.yaml.
DATABASE_URL="postgresql://trilha:trilha@localhost:5433/trilha?schema=public"

# Só se as migrations precisarem de uma conexão diferente da do app (ex.: banco com pooler).
# DIRECT_URL=""

# Reservado para assinar valores sensíveis. Gere um valor aleatório longo:
#   openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres"

# URL pública da aplicação (usada para montar o link do portal do cliente).
# Na Render, se ficar vazia, uso o endereço público do serviço (RENDER_EXTERNAL_URL).
APP_URL="http://localhost:3000"

# Só para rodar o seed contra um banco que NÃO seja local (ele apaga tudo):
# SEED_CONFIRM_RESET="yes"

# Primeiro acesso em produção: criados no primeiro start, se o banco estiver sem usuários.
# BOOTSTRAP_ADMIN_EMAIL=""
# BOOTSTRAP_ADMIN_PASSWORD=""
# SEED_EXAMPLE_DATA="true"
