# Copie para .env e preencha. NUNCA versione o .env.
# Os valores abaixo são apenas ilustrativos, não são credenciais reais.

# Conexão do app com o PostgreSQL.
# Local (docker compose up -d): postgresql://trilha:trilha@localhost:5433/trilha?schema=public
# Produção (Neon): use a connection string COM pooler (host com "-pooler") e sslmode=require.
DATABASE_URL="postgresql://trilha:trilha@localhost:5433/trilha?schema=public"

# Conexão DIRETA (sem pooler), usada só pelas migrations em produção (Neon).
# Em desenvolvimento local pode ficar vazia: cai em DATABASE_URL.
DIRECT_URL=""

# Reservado para assinar valores sensíveis. Gere um valor aleatório longo:
#   openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres"

# URL pública da aplicação (usada para montar o link do portal do cliente).
# Na Vercel, se ficar vazia, uso VERCEL_PROJECT_PRODUCTION_URL.
APP_URL="http://localhost:3000"

# Mostra as contas de demonstração na tela de login. Use "false" fora da demonstração.
DEMO_MODE="true"

# Só para rodar o seed contra um banco que NÃO seja local (ele apaga tudo):
# SEED_CONFIRM_RESET="yes"
