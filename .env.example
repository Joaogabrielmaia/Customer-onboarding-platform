# Copie para .env e preencha. NUNCA versione o .env.
# Os valores abaixo são apenas ilustrativos, não são credenciais reais.

# Conexão com o PostgreSQL (Neon ou Supabase em produção; local em desenvolvimento)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/trilha?schema=public"

# Segredo usado para assinar sessões. Gere um valor aleatório longo:
#   openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres"

# URL pública da aplicação (usada para montar o link do portal do cliente)
APP_URL="http://localhost:3000"
